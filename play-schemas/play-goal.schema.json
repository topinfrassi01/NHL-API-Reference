{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "integer"
    },
    "periodDescriptor": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "periodType": {
          "type": "string"
        },
        "maxRegulationPeriods": {
          "type": "integer"
        },
        "otPeriods": {
          "type": "integer"
        }
      },
      "required": [
        "maxRegulationPeriods",
        "number",
        "periodType"
      ]
    },
    "timeInPeriod": {
      "type": "string"
    },
    "timeRemaining": {
      "type": "string"
    },
    "situationCode": {
      "type": "string"
    },
    "homeTeamDefendingSide": {
      "type": "string"
    },
    "typeCode": {
      "type": "integer"
    },
    "typeDescKey": {
      "type": "string"
    },
    "sortOrder": {
      "type": "integer"
    },
    "details": {
      "type": "object",
      "properties": {
        "xCoord": {
          "type": "integer"
        },
        "yCoord": {
          "type": "integer"
        },
        "zoneCode": {
          "type": "string"
        },
        "shotType": {
          "type": "string"
        },
        "scoringPlayerId": {
          "type": "integer"
        },
        "scoringPlayerTotal": {
          "type": "integer"
        },
        "assist1PlayerId": {
          "type": "integer"
        },
        "assist1PlayerTotal": {
          "type": "integer"
        },
        "assist2PlayerId": {
          "type": "integer"
        },
        "assist2PlayerTotal": {
          "type": "integer"
        },
        "eventOwnerTeamId": {
          "type": "integer"
        },
        "goalieInNetId": {
          "type": "integer"
        },
        "awayScore": {
          "type": "integer"
        },
        "homeScore": {
          "type": "integer"
        },
        "highlightClipSharingUrl": {
          "type": "string"
        },
        "highlightClipSharingUrlFr": {
          "type": "string"
        },
        "highlightClip": {
          "type": "integer"
        },
        "highlightClipFr": {
          "type": "integer"
        },
        "discreteClip": {
          "type": "integer"
        },
        "discreteClipFr": {
          "type": "integer"
        },
        "goalInGame": {
          "type": "integer"
        }
      },
      "required": [
        "awayScore",
        "eventOwnerTeamId",
        "homeScore",
        "scoringPlayerId",
        "xCoord",
        "yCoord",
        "zoneCode"
      ]
    },
    "pptReplayUrl": {
      "type": "string"
    }
  },
  "required": [
    "details",
    "eventId",
    "homeTeamDefendingSide",
    "periodDescriptor",
    "situationCode",
    "sortOrder",
    "timeInPeriod",
    "timeRemaining",
    "typeCode",
    "typeDescKey"
  ]
}