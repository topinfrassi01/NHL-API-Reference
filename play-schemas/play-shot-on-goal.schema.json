{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "integer"
    },
    "periodDescriptor": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "periodType": {
          "type": "string"
        },
        "maxRegulationPeriods": {
          "type": "integer"
        },
        "otPeriods": {
          "type": "integer"
        }
      },
      "required": [
        "maxRegulationPeriods",
        "number",
        "periodType"
      ]
    },
    "timeInPeriod": {
      "type": "string"
    },
    "timeRemaining": {
      "type": "string"
    },
    "situationCode": {
      "type": "string"
    },
    "homeTeamDefendingSide": {
      "type": "string"
    },
    "typeCode": {
      "type": "integer"
    },
    "typeDescKey": {
      "type": "string"
    },
    "sortOrder": {
      "type": "integer"
    },
    "details": {
      "type": "object",
      "properties": {
        "xCoord": {
          "type": "integer"
        },
        "yCoord": {
          "type": "integer"
        },
        "zoneCode": {
          "type": "string"
        },
        "shotType": {
          "type": "string"
        },
        "shootingPlayerId": {
          "type": "integer"
        },
        "goalieInNetId": {
          "type": "integer"
        },
        "eventOwnerTeamId": {
          "type": "integer"
        },
        "awaySOG": {
          "type": "integer"
        },
        "homeSOG": {
          "type": "integer"
        }
      },
      "required": [
        "awaySOG",
        "eventOwnerTeamId",
        "goalieInNetId",
        "homeSOG",
        "shootingPlayerId",
        "shotType",
        "xCoord",
        "yCoord",
        "zoneCode"
      ]
    }
  },
  "required": [
    "details",
    "eventId",
    "homeTeamDefendingSide",
    "periodDescriptor",
    "situationCode",
    "sortOrder",
    "timeInPeriod",
    "timeRemaining",
    "typeCode",
    "typeDescKey"
  ]
}